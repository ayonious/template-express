{
  "compilerOptions": {
    "allowJs": true,
    "outDir": "dist",
    "rootDir": "src",
    "target": "ES2015",
    "noImplicitAny": true,
    "strictNullChecks": true,
    "module": "node16",
    "declaration": true,
    "lib": ["ES2015", "dom"],
    "strict": true,
    "types": ["jest", "node"],
    "esModuleInterop": true,
    "moduleResolution": "node16"
  },
  "include": ["src/**/*", "src/index.ts"]
}
